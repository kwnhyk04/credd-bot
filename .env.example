NODE_ENV=development
BOT_TOKEN=
CLIENT_ID=
DATABASE_URL=
DEV_IDS=

# Required in production. Used to load assets from Cloudflare R2 by public URL.
# Example: https://pub-xxxx.r2.dev
ASSET_BASE_URL=
# Required in production for one canonical cache key per R2 object path.
# Change it only when the R2 asset set changes.
ASSET_VERSION=2026-07-03

# Database TLS — set for any remote/hosted Postgres (leave both blank only when
# Postgres runs on the same host).
# PGSSL_CA: path to the provider's CA certificate → encrypts AND verifies the server
#           (preferred; takes precedence over PGSSL).
# PGSSL=require: encrypts without CA verification (fallback when no CA file is available;
#           equivalent to libpq sslmode=require).
PGSSL=
PGSSL_CA=

# Optional Postgres pool guardrails (milliseconds unless noted). Defaults shown;
# leave blank to use them. These make stalled connections/locks error out instead
# of hanging forever (prevents per-user battle deadlocks).
# PG_POOL_MAX=10               (connections)
# PG_CONNECT_TIMEOUT_MS=10000
PG_IDLE_TIMEOUT_MS=120000
# PG_QUERY_TIMEOUT_MS=30000
# PG_STATEMENT_TIMEOUT_MS=25000
# PG_IDLE_TXN_TIMEOUT_MS=60000

# Optional R2 WRITE credentials (S3 API) — enable deterministic generated
# canvases to upload once and then be served by URL instead of being retained
# or repeatedly uploaded through Discord (src/utils/canvasCache.js).
# R2_BUCKET must be the bucket ASSET_BASE_URL serves. Leave blank to disable
# (bot falls back to attaching, current behavior).
# Production: these R2 write credentials are required on Railway unless
# ALLOW_DISCORD_IMAGE_ATTACHMENTS=true is intentionally set.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Days a cache object may sit unused before the 6h sweep evicts it (default 14).
CANVAS_CACHE_MAX_AGE_DAYS=
# Throttle canvas_cache last_used_at writes per rendered cache key.
CANVAS_CACHE_TOUCH_THROTTLE_MS=300000

# Keep true to preserve full-quality Discord attachment fallback when an R2
# upload is unavailable. This is an explicit egress tradeoff: production
# preflight permits attachment-backed renders while enabled. R2 cache hits
# remain URL-only, so this does not disable R2 rendering.
ALLOW_DISCORD_IMAGE_ATTACHMENTS=true
BANDWIDTH_LOGS=false
PERFORMANCE_LOGS=false

# Production image optimization. WebP is preferred for generated opaque images;
# transparent renderers keep alpha where required and fall back safely if needed.
IMAGE_OUTPUT_FORMAT=webp
IMAGE_WEBP_QUALITY=55
PROFILE_IMAGE_WEBP_QUALITY=60
STATS_IMAGE_WEBP_QUALITY=60
BOSS_IMAGE_WEBP_QUALITY=55
PROFILE_IMAGE_MAX_WIDTH=0
STATS_IMAGE_MAX_WIDTH=0
BOSS_IMAGE_MAX_WIDTH=0
BOSS_OFFICIAL_GUILD_ID=1522127011768832141
OFFICIAL_SUPPORT_INVITE_URL=https://discord.gg/H4bSMHYsSk
# Optional Discord text channel for Custom Avatar/Deity Token requests.
# If unset or not resolvable in the current guild, replies use plain text.
CUSTOM_REQUEST_CHANNEL_ID=
BOSS_DAILY_ATTACK_LIMIT=2
IMAGE_COMPRESSION_AGGRESSIVE=true
IMAGE_RENDER_CONCURRENCY=1
IMAGE_RENDER_QUEUE_MAX=16
IMAGE_FAST_OPAQUE_ENCODE=true
SHARP_CACHE_MEMORY_MB=8
SHARP_CACHE_FILES=0
SHARP_CACHE_ITEMS=20
SHARP_CONCURRENCY=1

# Preserve the existing battle presentation: an opening Canvas followed by the
# final Canvas. Raid completion can also include its separate result Canvas.
BATTLE_FRAME_RENDER_MODE=start_and_final
BATTLE_FRAME_RENDER_COOLDOWN_MS=30000
BATTLE_RESULT_RENDER_ENABLED=true
RAID_BATTLE_FRAME_WEBP_QUALITY=50
RAID_BATTLE_RESULT_WEBP_QUALITY=50
RAID_IMAGE_MAX_WIDTH=0
BATTLE_STATIC_LAYER_CACHE_MAX=8
BATTLE_STATIC_LAYER_CACHE_TTL_MS=600000
BATTLE_RENDER_CACHE_MAX_MB=16

# Production resource snapshots. The runtime clamps this to no slower than the
# requested five-minute cadence; shorter intervals remain supported.
RESOURCE_LOGS=true
RESOURCE_LOG_INTERVAL_MS=300000
# Optional sub-gates. Each falls back to RESOURCE_LOGS when unset, so output is
# unchanged by default. Set one to false to silence just that stream:
#   COMMAND_MEMORY_LOGS  -> [renderer-memory] per-render/canvas lifecycle deltas
#   CACHE_METRICS_LOGS   -> caches/cacheEstimates blocks inside [resource]
#   NETWORK_USAGE_LOGS   -> network/postgresNetwork blocks inside [resource]
COMMAND_MEMORY_LOGS=true
CACHE_METRICS_LOGS=true
NETWORK_USAGE_LOGS=true

# Short-lived profile URL reuse. This stores URLs/signatures only, not image buffers.
PROFILE_IMAGE_CACHE_TTL_MS=60000
PROFILE_IMAGE_CACHE_MAX=50

# Remote asset cache controls. Mount a Railway Volume at /data and use the
# directory below to preserve downloaded source assets across deployments.
ASSET_DISK_CACHE_ENABLED=true
ASSET_DISK_CACHE_DIR=/data/credd-asset-cache
ASSET_DISK_CACHE_MAX_FILES=2000
ASSET_DISK_CACHE_MAX_MB=384
ASSET_DISK_CACHE_SWEEP_INTERVAL_MS=3600000
ASSET_DISK_CACHE_TOUCH_INTERVAL_MS=300000
ASSET_DISK_CACHE_SWEEP_WRITE_THRESHOLD=16
ASSET_MEMORY_CACHE_MAX_MB=40
ASSET_CACHE_TTL_MS=1800000
ASSET_REMOTE_CHECK_MAX=1000
ASSET_REMOTE_MISS_TTL_MS=600000
ASSET_REMOTE_MISS_MAX=1000
# Bound remote asset fetches so image commands fall back instead of waiting indefinitely.
ASSET_FETCH_TIMEOUT_MS=10000
CANVAS_MEMORY_CACHE_MAX_MB=8
LAYOUT_METADATA_CACHE_MAX=64
MOB_ROSTER_CACHE_MAX=32
EMOJI_IMAGE_CACHE_MAX=256
EMOJI_IMAGE_CACHE_MAX_MB=4
EMOJI_IMAGE_CACHE_TTL_MS=1800000
EMOJI_REMOTE_MISS_TTL_MS=600000
EMOJI_REMOTE_MISS_MAX=256
EMOJI_FETCH_TIMEOUT_MS=10000

# DB/write and selection-pool production tuning.
USER_ACTIVITY_WRITE_THROTTLE_MS=60000
SELECTION_POOL_CACHE_TTL_MS=300000
SELECTION_POOL_CACHE_MAX=50

# Boss runtime log cache caps. Damage/rewards remain stored in the database.
# Surviving attacks still render the latest boss HP Canvas. The debounce
# coalesces nearby attacks so one current status image replaces multiple stale ones.
BOSS_LOG_CACHE_MAX_ATTACKERS=50
BOSS_LOG_CACHE_MAX_EVENTS_PER_ATTACKER=20
BOSS_IMAGE_REFRESH_ENABLED=true
BOSS_IMAGE_REFRESH_DEBOUNCE_MS=15000
BOSS_BANNER_CACHE_MAX=4
BOSS_BANNER_CACHE_MAX_MB=8
BOSS_BANNER_CACHE_TTL_MS=600000
CASINO_ENABLED=true
CASINO_CARD_FACE_CACHE_MAX=8
CASINO_CARD_FACE_CACHE_MAX_MB=4
CASINO_CARD_FACE_CACHE_TTL_MS=600000
CASINO_MEDIA_CACHE_MAX=12
CASINO_MEDIA_CACHE_MAX_MB=24
CASINO_MEDIA_CACHE_TTL_MS=600000

# Optional slash-command deployment override. Leave blank for global deploy.
GUILD_IDS=
# Startup sync registers slash commands to GUILD_IDS, or to every guild the bot is in
# when GUILD_IDS is blank. Set false only if you deploy commands manually.
SYNC_SLASH_COMMANDS_ON_START=true

# Optional supporter/tester defaults. Keep false/blank for production unless intentionally enabled.
BETA_MODE=false
DEV_ACCOUNT_IDS=
# Dev/test only. When true, DEV_ACCOUNT_IDS can view/equip all class-valid avatars without purchase.
# Defaults on outside NODE_ENV=production, or on Railway environments not named production/prod.
AVATAR_DEV_UNLOCKS=false

# Dangerous dev-only overrides. Keep false in production.
ALLOW_DESTRUCTIVE_DEV_COMMANDS=false
ALLOW_HIGH_VALUE_DEV_COMMANDS=false
ALLOW_SUPPORTER_DEV_COMMANDS=false
ALLOW_LIVE_EVENT_DEV_COMMANDS=false
