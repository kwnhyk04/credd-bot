tmp/

# Agent instruction and scratch files stay local.
#
# docs/ is TRACKED. CLAUDE.md makes /docs the documentation source of truth —
# every file there is ingested by the site's RAG chatbot, and the docs index is
# required to list every document. Ignoring the directory contradicted that, and
# meant documentation work could never actually land.
AGENTS.md
AGENT.md
CLAUDE.md
claude.md
Handoff.md
handoff.md
todo.md

# Local-only development and validation scripts. Production migrations,
# schemas, preflight, deployment, compensation, seed, and repair tools remain tracked.
# Selftests are tracked: they are the refactor characterization gate (Phase 0/1)
# and CI runs them via npm run selftest:full.
scripts/*benchmark.js
scripts/alignSkins.js
scripts/analyze-resource-logs.js
scripts/build-casino-spin-assets.js
scripts/buildProfilePreviewSheet.js
scripts/diagnose-founder.js
scripts/diagnose-supporter-badges.js
scripts/gen_description_patch.js
scripts/recompress-assets.js
scripts/render-requested-preview.js
scripts/renderSkinDesignPreview.js
scripts/skinPreview.js
!scripts/v5_wipe_test_gear.js

