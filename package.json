    "node": ">=20.9.0"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "discord.js": "^14.19.0",
    "dotenv": "^16.4.7",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "sharp": "^0.35.1"
  },
  "devDependencies": {
    "supabase": "^2.109.0"
  },
  "overrides": {
    "undici": "^6.26.1",
    "uuid": "^11.1.1"
