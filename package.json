    "selftest:bestow": "node scripts/bestow-limit-selftest.js",
    "selftest:patch": "node scripts/requested-patch-selftest.js",
    "selftest:combat-reward-update": "node scripts/combat-reward-update-selftest.js",
    "selftest:reward-summon-qol": "node scripts/reward-summon-qol-selftest.js",
    "selftest:result-colors": "node scripts/result-embed-color-selftest.js",
